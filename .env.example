POSTGRESQL_DB_URL=
RUST_LOG=
PORT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
DRY_RUN=
MAX_ORDER_USD=
TM_SETTLEMENT_ASSET=
MAX_USER_SPEND_USD=
GLOBAL_FLOOR_USD=
NGROK_AUTH_TOKEN=
NGROK_DOMAIN=
WEB_APP_URL=
WEB_UPSTREAM_URL=
TEST_BUY_ENABLED=
# At least 16 characters, otherwise /admin is disabled.
ADMIN_API_KEY=
APP_MODE=development
TRUE_MARKET_BASE_URL=https://api.truemarkets.co/v1/
TM_KEY_FILE=
TURNKEY_SECRET_ID=
TURNKEY_ORGANIZATION_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_BASE_URL=https://api.turnkey.com
TM_ORGANIZATION_ID=

SIGNING_MASTER_KEYS=1:<64 hex chars>
SIGNING_ACTIVE_KEY_VERSION=1
SIGNING_MAX_ORDER_USD=50
SIGNING_DAILY_LIMIT_USD=200
SIGNING_INTENT_TTL_SECS=120
SIGNING_MAX_PAYLOADS=4
SIGNING_ALLOWED_ACTIVITY_TYPES=


JWT_SECRET=<at least 32 random bytes>
ACCESS_TOKEN_TTL_SECS=900
REFRESH_TOKEN_TTL_SECS=2592000

# Engine. DRY_RUN defaults to true: orders are planned and recorded but never placed.
DRY_RUN=true
ENGINE_ENABLED=true
ENGINE_POLL_SECS=30
# Gateway execute auth type (api_key when the server holds the signer key); required when DRY_RUN=false.
TM_EXECUTE_AUTH_TYPE=api_key
WITHDRAW_ADDRESS_COOLDOWN_SECS=86400
SIGNING_MAX_SELL_USD=500
SIGNING_SELL_DAILY_LIMIT_USD=2000
SIGNING_MAX_WITHDRAW_USD=100
SIGNING_WITHDRAW_DAILY_LIMIT_USD=200

# vendor looks each NIN up; auto approves everyone and only works with APP_MODE=development.
KYC_MODE=vendor
KYC_VENDORS=prembly
PREMBLY_API_KEY=
PREMBLY_BASE_URL=https://api.prembly.com
# At least 16 characters; use values of your own rather than the Swiftgigs ones.
NIN_HASH_SALT=
# 64 hex characters.
NIN_ENCRYPTION_KEY=
KYC_MAX_LOOKUPS_PER_USER_PER_DAY=3
KYC_MAX_LOOKUPS_PER_NIN_PER_DAY=3
