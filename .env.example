# Server
POSTGRESQL_DB_URL=postgres://postgres:mysecretpassword@localhost:5432/usetenth
PORT=3000
APP_MODE=development
# At least 16 characters, otherwise /admin is disabled.
ADMIN_API_KEY=
# Public https URL of the web app that the bot's buttons open.
WEB_APP_URL=
NGROK_AUTH_TOKEN=
NGROK_DOMAIN=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Mobile sessions
JWT_SECRET=<at least 32 random bytes>
ACCESS_TOKEN_TTL_SECS=900
REFRESH_TOKEN_TTL_SECS=2592000

# True Markets gateway
TRUE_MARKET_BASE_URL=https://api.truemarkets.co/v1/gateway
TM_ORGANIZATION_ID=
# Development reads the API key from this file; production reads it from Turnkey.
TM_KEY_FILE=
TURNKEY_ORGANIZATION_ID=
TURNKEY_SECRET_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_BASE_URL=https://api.turnkey.com
# Gateway execute auth type (api_key when the server holds the signer key); required when DRY_RUN=false.
TM_EXECUTE_AUTH_TYPE=api_key
TM_SETTLEMENT_ASSET=USDC

# Engine: DRY_RUN defaults to true, so orders are planned and recorded but never placed.
DRY_RUN=true
ENGINE_ENABLED=true
ENGINE_POLL_SECS=30
GLOBAL_FLOOR_USD=1
MAX_ORDER_USD=50
MAX_USER_SPEND_USD=
WITHDRAW_ADDRESS_COOLDOWN_SECS=86400

# Signing: user keys are wrapped with a versioned master key, written as version:64 hex chars.
SIGNING_MASTER_KEYS=1:<64 hex chars>
SIGNING_ACTIVE_KEY_VERSION=1
SIGNING_MAX_ORDER_USD=50
SIGNING_DAILY_LIMIT_USD=200
SIGNING_MAX_SELL_USD=500
SIGNING_SELL_DAILY_LIMIT_USD=2000
SIGNING_MAX_WITHDRAW_USD=100
SIGNING_WITHDRAW_DAILY_LIMIT_USD=200
SIGNING_INTENT_TTL_SECS=120
SIGNING_MAX_PAYLOADS=4
# Comma-separated gateway activity types that may be signed; empty refuses everything.
SIGNING_ALLOWED_ACTIVITY_TYPES=

# KYC: vendor looks each NIN up; auto approves everyone and only works with APP_MODE=development.
KYC_MODE=vendor
KYC_VENDORS=prembly
PREMBLY_API_KEY=
PREMBLY_BASE_URL=https://api.prembly.com
# At least 16 characters; use a value of your own.
NIN_HASH_SALT=
# 64 hex characters.
NIN_ENCRYPTION_KEY=
KYC_MAX_LOOKUPS_PER_USER_PER_DAY=3
KYC_MAX_LOOKUPS_PER_NIN_PER_DAY=3
